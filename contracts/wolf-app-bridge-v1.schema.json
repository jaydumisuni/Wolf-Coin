{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thetechguyds.com/contracts/wolf-app-bridge-v1.schema.json",
  "title": "Wolf-Coin native application bridge request (envelope only)",
  "description": "Authenticated local IPC; operation-specific payloads are validated by wolf_app.contracts and wolf_app.store. Never transport credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "operation",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "wolf.app.request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "account.read",
        "account.register",
        "account.remove",
        "accounts.list",
        "activity.list",
        "bridge.capabilities",
        "context.route",
        "decision.propose",
        "decision.receipt",
        "decisions.list",
        "financial.history",
        "financial.overview",
        "host.startup",
        "observation.discover",
        "observation.ingest",
        "session.record",
        "sync.cancel",
        "sync.claim",
        "sync.enqueue",
        "sync.inbox",
        "sync.plan",
        "sync.receipt",
        "sync.reconcile"
      ]
    },
    "payload": {
      "type": "object"
    },
    "auth_tag": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "HMAC-SHA256 of canonical request excluding auth_tag, generated by native host"
    }
  }
}
