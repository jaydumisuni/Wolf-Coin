name: Review Worker (reusable)

on:
  workflow_call:
    inputs:
      specialist:
        required: true
        type: string
      changed_files:
        required: false
        type: string
      pr_number:
        required: false
        type: number

jobs:
  run-specialist:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.10"

      - name: Install deps (if any)
        run: |
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
          # If you use pyproject/poetry, adjust this step.

      - name: Run specialist runner (best-effort)
        id: run
        run: |
          set -e
          SPECIALIST="${{ inputs.specialist }}"
          FILES="${{ inputs.changed_files }}"
          mkdir -p out
          # Prefer sergeant CLI if available (owner may have installed it in this repo)
          if command -v sergeant >/dev/null 2>&1; then
            echo "Running sergeant for specialist $SPECIALIST"
            # This is a placeholder invocation — adapt to your sergeant/CLI flags if different
            sergeant pr-review . --files "$FILES" --pretty || true
            # attempt to capture output into an artifact
            if [ -f sergeant-report.json ]; then
              cp sergeant-report.json out/evidence-${SPECIALIST}.json
            fi
          elif [ -f "wolf_officers/${SPECIALIST}.py" ]; then
            echo "Running wolf_officers/${SPECIALIST}.py"
            python wolf_officers/${SPECIALIST}.py --files "$FILES" --output out/evidence-${SPECIALIST}.json || true
          else
            echo '{"specialist":"'"$SPECIALIST"'","files":"'"$FILES"'","notes":"placeholder — no runner configured"}' > out/evidence-${SPECIALIST}.json
          fi
          ls -la out || true

      - name: Upload evidence artifact
        uses: actions/upload-artifact@v4
        with:
          name: evidence-${{ inputs.specialist }}-${{ inputs.pr_number || 'local' }}
          path: out/evidence-${{ inputs.specialist }}.json
